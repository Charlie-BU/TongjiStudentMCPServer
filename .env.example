# 与 TongjiStudentAgent 使用同一 PostgreSQL 数据库；本地先执行 sql/user_luckin_credentials.sql。
# GitLab 部署不建表；数据库须已具备 sql/user_luckin_credentials.sql 定义的表。
# 进程环境变量优先于 .env，连接串特殊字符须 URL 编码。
POSTGRES_DSN=postgres://<username>:<password>@<db-host>:5432/tongji_student?sslmode=disable

# Application port; unrelated to the GitLab SSH variable named PORT.
PORT=3100
