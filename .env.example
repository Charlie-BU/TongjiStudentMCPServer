# 应用监听端口。
APP_PORT=3100

# 单次上游 HTTP 请求超时，单位为毫秒，默认 20 秒。
UPSTREAM_TIMEOUT_MS=20000

# 用于直接 Bearer 认证及确认 OAuth 授权的 API Key 数组；空数组禁用这两种方式。
# 请使用独立生成的随机密钥，每个至少包含 32 个无空白 ASCII 字符。
ALLOWED_API_KEYS='[]'

# OAuth 访问令牌有效期，单位为秒；代码默认值为 2592000（30 天）；-1 表示永久有效。
ACCESS_TOKEN_EXPIRE_SECONDS=-1

# 服务公开的 HTTPS 源地址，不带 /mcp；本地开发允许使用回环地址的 HTTP。
MCP_PUBLIC_URL=http://localhost:3100

# 持久化目录优先级：显式指定目录 > Railway 挂载目录 > 项目 data/ 目录。
# 留空时，在 Railway 上自动使用 RAILWAY_VOLUME_MOUNT_PATH。
MCP_DATA_DIR=<your_mcp_data_dir>
