# Application port.
APP_PORT=3100

# Timeout for each upstream HTTP request, in milliseconds. Defaults to 20 seconds.
UPSTREAM_TIMEOUT_MS=20000

# API keys for direct Bearer authentication and OAuth consent. Empty array disables both.
# Use independent random keys of at least 32 non-space ASCII characters.
ALLOWED_API_KEYS='[]'

# OAuth lifetime in seconds; code default is 2592000. This example uses permanent tokens.
# -1 means no time expiry. No refresh tokens.
ACCESS_TOKEN_EXPIRE_SECONDS=-1

# Public HTTPS origin, without /mcp. Loopback HTTP is permitted for local development.
MCP_PUBLIC_URL=http://localhost:3100
